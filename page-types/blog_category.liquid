<main id="main-content" class="blog-page">
    {% for post in blog.posts %}{% if post.cover_media %}{% unless hero_image %}{% assign hero_image = post.cover_media %}{% endunless %}{% endif %}{% endfor %}<header class="blog-header{% if hero_image %} has-image{% endif %}">{% if hero_image %}<img class="hero-backdrop" src="{{ hero_image.url }}" alt="" width="{{ hero_image.width }}" height="{{ hero_image.height }}">{% endif %}<div class="hero-shade"></div><div class="blog-shell"><nav class="blog-breadcrumbs" aria-label="{{ 'Breadcrumb' | t }}"><a href="{{ routes.home }}">{{ 'Home' | t }}</a><span>/</span><a href="{{ blog.url }}">{{ 'Blog' | t }}</a><span>/</span><span aria-current="page">{{ blog.title }}</span></nav><h1>{{ blog.title }}</h1></div></header>
    <section class="blog-content"><div class="blog-shell"><nav class="blog-category-links" aria-label="{{ 'Categories' | t }}"><a href="{{ blog.url }}">{{ 'All posts' | t }}</a>{% for category in blog.categories %}<a href="{{ category.url }}">{{ category.name }}</a>{% endfor %}</nav>
    <div class="blog-grid">{% for post in blog.posts %}<article class="blog-card">{% if post.cover_media %}<a class="blog-card-media" href="{{ post.url }}" tabindex="-1" aria-hidden="true"><img src="{{ post.cover_media.url }}" alt="" loading="lazy" width="{{ post.cover_media.width }}" height="{{ post.cover_media.height }}"></a>{% endif %}<div class="blog-card-copy"><time datetime="{{ post.published_at }}">{{ post.published_date }}</time><h2><a href="{{ post.url }}">{{ post.title }}</a></h2><p>{{ post.summary }}</p><a class="blog-card-read" href="{{ post.url }}">{{ 'Read article' | t }} →</a></div></article>{% endfor %}{% if blog.posts.size == 0 %}<p class="blog-empty">{{ 'No posts yet' | t }}</p>{% endif %}</div>
    <nav class="blog-pagination" aria-label="{{ 'Pagination' | t }}">{% if blog.pagination.previous_url %}<a href="{{ blog.pagination.previous_url }}">← {{ 'Previous' | t }}</a>{% else %}<span></span>{% endif %}{% if blog.pagination.next_url %}<a href="{{ blog.pagination.next_url }}">{{ 'Next' | t }} →</a>{% endif %}</nav></div></section>
</main>
