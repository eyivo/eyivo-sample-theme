<main id="main-content">
    {{ areas.intro | raw }}
    <section class="page-hero inner-hero"><div class="shell hero-content"><nav class="breadcrumbs" aria-label="{{ 'Breadcrumb' | t }}"><a href="{{ routes.home }}">{{ 'Home' | t }}</a><span>/</span><span aria-current="page">{{ theme.settings.catalog_label }}</span></nav><p class="eyebrow">{{ "Explore the range" | t }}</p><h1>{{ theme.settings.catalog_label }}</h1><p class="hero-summary">{{ company.description }}</p></div></section>
    <section class="section"><div class="shell"><div class="catalog-toolbar"><p><strong>{{ products.size }}</strong> {{ "selected entries" | t }}</p><label><span class="sr-only">{{ "Filter entries" | t }}</span><input type="search" placeholder="{{ "Filter by name" | t }}" data-card-filter></label></div><div class="native-card-grid" data-filter-grid>{% for product in products %}<a class="native-card" href="{{ product.url }}" data-filter-card data-filter-text="{{ product.title }} {{ product.summary }}">{% if product.cover_media %}<img src="{{ product.cover_media.url }}" alt="{{ product.title }}" loading="lazy" width="{{ product.cover_media.width }}" height="{{ product.cover_media.height }}">{% endif %}<div><span>0{{ forloop.index }}</span><h2>{{ product.title }}</h2><p>{{ product.summary }}</p><b>{{ 'View details' | t }} ↗</b></div></a>{% endfor %}</div></div></section>
    {{ areas.main | raw }}
</main>
