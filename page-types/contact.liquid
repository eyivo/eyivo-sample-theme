<main id="main-content">
    {{ areas.intro | raw }}
    <section class="page-hero inner-hero contact-hero"><div class="shell hero-content"><nav class="breadcrumbs" aria-label="{{ 'Breadcrumb' | t }}"><a href="{{ routes.home }}">{{ 'Home' | t }}</a><span>/</span><span aria-current="page">{{ page.title }}</span></nav><p class="eyebrow">{{ page.title }}</p><h1>{{ page.title }}</h1><p class="hero-summary">{{ "Tell us what you are working on. You will hear from a real person who understands the work." | t }}</p></div></section>
    <section class="section contact-section"><div class="shell contact-layout"><div class="contact-aside"><p class="eyebrow">{{ "Contact details" | t }}</p><h2>{{ "Start with a conversation." | t }}</h2>{% if company.phone %}<a href="tel:{{ company.phone }}"><span>{{ "Phone" | t }}</span><strong>{{ company.phone }}</strong></a>{% endif %}{% if company.email %}<a href="mailto:{{ company.email }}"><span>{{ "Email" | t }}</span><strong>{{ company.email }}</strong></a>{% endif %}{% if company.address %}<div><span>{{ "Visit" | t }}</span><strong>{{ company.address }}</strong></div>{% endif %}</div><form class="lead-form" method="post" action="{{ contact.action }}" data-fp-contact><input type="hidden" name="_token" value="{{ contact.csrf_token }}"><div class="form-heading"><span>01</span><h2>{{ "How can we help?" | t }}</h2></div>{% if contact.success %}<p class="form-success" role="status">{{ contact.success }}</p>{% endif %}{% if contact.has_errors %}<p class="form-error" role="alert">{{ "Please review the highlighted information." | t }}</p>{% endif %}<label>{{ "Name" | t }}<input name="name" value="{{ contact.old.name }}" required autocomplete="name"></label><label>{{ "Email" | t }}<input type="email" name="email" value="{{ contact.old.email }}" required autocomplete="email"></label><label>{{ "Phone" | t }} <small>{{ "Optional" | t }}</small><input name="phone" value="{{ contact.old.phone }}" autocomplete="tel"></label><label>{{ "Tell us about your project" | t }}<textarea name="message" rows="5" required>{{ contact.old.message }}</textarea></label><input class="honeypot" name="website" tabindex="-1" autocomplete="off"><button class="button" type="submit">{{ "Send enquiry" | t }} <span>↗</span></button>{% if contact.turnstile.enabled %}<div class="cf-turnstile" data-sitekey="{{ contact.turnstile.site_key }}"></div>{% endif %}</form></div></section>
    {{ areas.main | raw }}
</main>
