    "capabilities": {
        "custom_javascript": false,
        "external_assets": false
    },
    "settings": {
        "accent_color": {
            "type": "color",
            "help": "Choose a color for this part of the theme."
        },
        "secondary_color": {
            "type": "color",
            "help": "Choose a color for this part of the theme."
        },
        "catalog_label": {
            "type": "text",
            "placeholder": "e.g. Services"
        },
        "status_label": {
            "type": "text",
            "placeholder": "e.g. Available for enquiries"
        },
        "showcase_heading": {
            "type": "text",
            "placeholder": "Describe showcase heading."
        },
        "showcase_text": {
            "type": "textarea",
            "placeholder": "Describe showcase text."
        },
        "header_cta_label": {
            "type": "text",
            "placeholder": "Describe header cta label."
        },
        "header_cta_url": {
            "type": "url",
            "placeholder": "/contact"
        },
        "announcement_text": {
            "type": "text",
            "placeholder": "Describe announcement text."
        },
        "announcement_link_label": {
            "type": "text",
            "placeholder": "Describe announcement link label."
        },
        "announcement_link_url": {
            "type": "url",
            "placeholder": "/catalog"
        },
        "footer_tagline": {
            "type": "textarea",
            "placeholder": "Describe footer tagline."
        },
        "whatsapp_url": {
            "type": "url",
            "placeholder": "https://wa.me/your-number"
        },
        "show_back_to_top": {
            "type": "boolean",
            "help": "Choose whether to display this option."
        },
        "show_color_mode": {
            "type": "boolean",
            "help": "Choose whether to display this option."
        }
    },
    "defaults": {
        "catalog_label": "Services",
        "status_label": "Open for new projects",
        "showcase_heading": "One theme. Every essential building block.",
        "showcase_text": "This public sample demonstrates localized layouts, editable settings, reusable components, catalogs, galleries, video, contact forms, responsive navigation, and accessible interaction patterns.",
        "header_cta_label": "Contact us",
        "header_cta_url": "/contact",
        "footer_tagline": "A flexible starting point for your next Eyivo theme.",
        "show_back_to_top": true,
        "show_color_mode": false,
        "announcement_text": "Welcome to the Eyivo sample theme.",
        "announcement_link_label": "Explore services",
        "announcement_link_url": "/catalog"
    },
    "page_types": {
        "home": {
            "areas": {
                "hero": {
                    "allowed_components": [
                        "eyivo:hero"
                    ],
                    "min": 0,
                    "max": 1
                },
                "main": {
                    "allowed_components": [
                        "eyivo:rich_text",
                        "eyivo:image_text",
                        "eyivo:stats",
                        "eyivo:feature_grid",
                        "eyivo:service_grid",
                        "eyivo:collection_grid",
                        "eyivo:media_gallery",
                        "eyivo:contact_actions",
                        "eyivo:location_map",
                        "eyivo:image_slider",
                        "eyivo:search_filter",
                        "eyivo:video",
                        "eyivo:price_offer",
                        "eyivo:announcement",
                        "eyivo:article_list",
                        "eyivo:event_list",
                        "eyivo:faq",
                        "eyivo:testimonials",
                        "eyivo:logo_cloud",
                        "eyivo:project_grid",
                        "eyivo:team_grid",
                        "eyivo:business_hours",
                        "eyivo:download_list",
                        "eyivo:tabs",
                        "eyivo:credentials",
                        "eyivo:product_specs",
                        "eyivo:cta",
                        "theme:capability_note"
                    ]
                },
                "bottom": {
                    "allowed_components": [
                        "eyivo:lead_form",
                        "eyivo:cta",
                        "eyivo:contact_details",
                        "eyivo:contact_actions"
                    ],
                    "min": 0
                }
            },
            "uses_body": false
        },
        "page": {
            "areas": {
                "hero": {
                    "allowed_components": [
                        "eyivo:hero"
                    ],
                    "min": 0,
                    "max": 1
                },
                "main": {
                    "allowed_components": [
                        "eyivo:rich_text",
                        "eyivo:image_text",
                        "eyivo:stats",
                        "eyivo:feature_grid",
                        "eyivo:service_grid",
                        "eyivo:media_gallery",
                        "eyivo:video",
                        "eyivo:article_list",
                        "eyivo:event_list",
                        "eyivo:faq",
                        "eyivo:testimonials",
                        "eyivo:logo_cloud",
                        "eyivo:project_grid",
                        "eyivo:team_grid",
                        "eyivo:business_hours",
                        "eyivo:download_list",
                        "eyivo:tabs",
                        "eyivo:credentials",
                        "eyivo:cta",
                        "theme:capability_note"
                    ]
                },
                "bottom": {
                    "allowed_components": [
                        "eyivo:lead_form",
                        "eyivo:cta",
                        "eyivo:contact_actions"
                    ],
                    "min": 0
                }
            },
            "uses_body": true
        },
        "gallery": {
            "areas": {
                "intro": {
                    "allowed_components": [
                        "eyivo:hero",
                        "eyivo:rich_text"
                    ],
                    "min": 0
                },
                "main": {
                    "allowed_components": [
                        "eyivo:media_gallery",
                        "eyivo:image_slider",
                        "eyivo:project_grid",
                        "eyivo:cta"
                    ],
                    "min": 0
                }
            },
            "uses_body": false
        },
        "contact": {
            "areas": {
                "intro": {
                    "allowed_components": [
                        "eyivo:hero",
                        "eyivo:rich_text"
                    ],
                    "min": 0
                },
                "main": {
                    "allowed_components": [
                        "eyivo:contact_details",
                        "eyivo:contact_actions",
                        "eyivo:lead_form",
                        "eyivo:location_map",
                        "eyivo:business_hours",
                        "eyivo:faq"
                    ],
                    "min": 0
                }
            },
            "uses_body": false
        },
        "products": {
            "areas": {
                "intro": {
                    "allowed_components": [
                        "eyivo:hero",
                        "eyivo:rich_text",
                        "eyivo:search_filter"
                    ],
                    "min": 0
                },
                "main": {
                    "allowed_components": [
                        "eyivo:collection_grid",
                        "eyivo:feature_grid",
                        "eyivo:cta"
                    ],
                    "min": 0
                }
            },
            "uses_body": false
        },
        "product": {
            "areas": {
                "intro": {
                    "allowed_components": [
                        "eyivo:hero"
                    ],
                    "min": 0,
                    "max": 1
                },
                "main": {
                    "allowed_components": [
                        "eyivo:product_specs",
                        "eyivo:media_gallery",
                        "eyivo:download_list",
                        "eyivo:tabs",
                        "eyivo:faq",
                        "eyivo:lead_form",
                        "eyivo:cta"
                    ],
                    "min": 0
                }
            },
            "uses_body": true
        },
        "videos": {
            "areas": {
                "intro": {
                    "allowed_components": [
                        "eyivo:hero",
                        "eyivo:rich_text"
                    ],
                    "min": 0
                },
                "main": {
                    "allowed_components": [
                        "eyivo:video",
                        "eyivo:cta"
                    ],
                    "min": 0
                }
            },
            "uses_body": false
        },
        "blog": {
            "uses_body": false,
            "areas": {}
        },
        "blog_category": {
            "uses_body": false,
            "areas": {}
        },
        "blog_post": {
            "uses_body": false,
            "areas": {}
        }
    },
    "components": {
        "capability_note": {
            "variants": [
                "default",
                "accent"
            ],
            "schema": {
                "label": {
                    "placeholder": "e.g. Theme feature",
                    "type": "text",
                    "translatable": true
                },
                "heading": {
                    "placeholder": "e.g. Build with reusable sections",
                    "type": "text",
                    "required": true,
                    "translatable": true
                },
                "text": {
                    "type": "richtext",
                    "translatable": true,
                    "help": "Describe this capability with paragraphs, lists, images, and links to published pages."
                },
                "link_label": {
                    "placeholder": "e.g. Explore more",
                    "type": "text",
                    "translatable": true
                },
                "link_url": {
                    "placeholder": "https://example.com/about",
                    "type": "url"
                }
            },
            "defaults": {
                "label": "Theme capability",
                "heading": "Build a site from reusable content blocks.",
                "text": "This is a theme-owned component. It can be added, translated, reordered, drafted, and published like an Eyivo core component.",
                "link_label": "Explore"
            }
        }
    },
    "plugins": [
        "eyivo/contact",
        "eyivo/quote-request",
        "eyivo/product-inquiry",
        "eyivo/appointment-request",
        "eyivo/course-application",
        "eyivo/reservation-request",
        "eyivo/property-inquiry"
    ],
    "forms": {
        "contact": {
            "plugin": "eyivo/contact",
            "type": "contact",
            "schema_version": 1,
            "instance": "default"
        },
        "quote_request": {
            "plugin": "eyivo/quote-request",
            "type": "quote_request",
            "schema_version": 1,
            "instance": "default"
        },
        "product_inquiry": {
            "plugin": "eyivo/product-inquiry",
            "type": "product_inquiry",
            "schema_version": 1,
            "instance": "default"
        },
        "appointment": {
            "plugin": "eyivo/appointment-request",
            "type": "appointment",
            "schema_version": 1,
            "instance": "default"
        },
        "course_application": {
            "plugin": "eyivo/course-application",
            "type": "course_application",
            "schema_version": 1,
            "instance": "default"
        },
        "reservation": {
            "plugin": "eyivo/reservation-request",
            "type": "reservation",
            "schema_version": 1,
            "instance": "default"
        },
        "property_inquiry": {
            "plugin": "eyivo/property-inquiry",
            "type": "property_inquiry",
            "schema_version": 1,
            "instance": "default"
        }
    },
    "menus": {
        "footer": {
            "label": "Footer links",
            "description": "Links displayed in the footer on every page.",
            "initialize_from_main": true,
            "translations": {
                "tr": {
                    "label": "Alt bilgi bağlantıları",
                    "description": "Her sayfanın alt bilgisinde gösterilen bağlantılar."
                }
            }
        },
        "useful_links": {
            "label": "Useful links",
            "description": "A separate list of helpful links in the footer.",
            "translations": {
                "tr": {
                    "label": "Yararlı bağlantılar",
                    "description": "Alt bilgide ayrı gösterilen yararlı bağlantılar."
                }
            }
        }
    }
}
