<main id="main-content">
    {{ areas.intro | raw }}
    {% for gallery in galleries %}{% for item in gallery.items %}{% if item.media %}{% unless hero_image %}{% assign hero_image = item.media %}{% endunless %}{% endif %}{% endfor %}{% endfor %}<section class="page-hero inner-hero{% if hero_image %} has-image{% endif %}">{% if hero_image %}<img class="hero-backdrop" src="{{ hero_image.url }}" alt="" width="{{ hero_image.width }}" height="{{ hero_image.height }}">{% endif %}<div class="hero-shade"></div><div class="shell hero-content"><nav class="breadcrumbs" aria-label="{{ 'Breadcrumb' | t }}"><a href="{{ routes.home }}">{{ 'Home' | t }}</a><span>/</span><span aria-current="page">{{ page.title }}</span></nav><p class="eyebrow">{{ 'Selected moments' | t }}</p><h1>{{ page.title }}</h1></div></section>
    {% for gallery in galleries %}<section class="section"><div class="shell"><div class="section-heading"><div><p class="eyebrow">{{ 'Collection' | t }}</p><h2>{{ gallery.title }}</h2><p>{{ gallery.description }}</p></div></div><div class="gallery-grid fp-gallery-{{ gallery.presentation_mode }}">{% for item in gallery.items %}<figure>{% if item.media %}<img src="{{ item.media.url }}" alt="{{ item.alt_text }}" loading="lazy" width="{{ item.media.width }}" height="{{ item.media.height }}">{% endif %}<figcaption><strong>{{ item.title }}</strong><span>{{ item.caption }}</span></figcaption></figure>{% endfor %}</div></div></section>{% endfor %}
    {{ areas.main | raw }}

     {% eyivo_component "eyivo:cta",
        eyebrow: page.title,
        heading: theme.settings.footer_tagline,
        text: company.description,
        button_label: theme.settings.catalog_label,
        button_url: routes.catalog
    %}
</main>
