<main id="main-content">
    {{ areas.intro | raw }}
    {% for product in products %}{% if product.cover_media %}{% unless hero_image %}{% assign hero_image = product.cover_media %}{% endunless %}{% endif %}{% endfor %}<section class="page-hero inner-hero{% if hero_image %} has-image{% endif %}">{% if hero_image %}<img class="hero-backdrop" src="{{ hero_image.url }}" alt="" width="{{ hero_image.width }}" height="{{ hero_image.height }}">{% endif %}<div class="hero-shade"></div><div class="shell hero-content"><nav class="breadcrumbs" aria-label="{{ 'Breadcrumb' | t }}"><a href="{{ routes.home }}">{{ 'Home' | t }}</a><span>/</span><span aria-current="page">{{ theme.settings.catalog_label }}</span></nav><p class="eyebrow">{{ "Explore the range" | t }}</p><h1>{{ theme.settings.catalog_label }}</h1><p class="hero-summary">{{ company.description }}</p></div></section>
    <section class="section"><div class="shell"><div class="catalog-search" data-filter-search="#catalog-grid" hidden><label for="catalog-search">{{ 'Search the catalog' | t }}</label><input id="catalog-search" type="search" placeholder="{{ 'Search by name or description' | t }}" autocomplete="off"><p data-filter-empty hidden>{{ 'Nothing matches your search.' | t }}</p></div><div class="native-card-grid" id="catalog-grid" data-filter-grid>{% for product in products %}<a class="native-card" href="{{ product.url }}" data-filter-card data-filter-text="{{ product.title }} {{ product.summary }}">{% if product.cover_media %}<img src="{{ product.cover_media.url }}" alt="{{ product.title }}" loading="lazy" width="{{ product.cover_media.width }}" height="{{ product.cover_media.height }}">{% endif %}<div><span>0{{ forloop.index }}</span><h2>{{ product.title }}</h2><p>{{ product.summary }}</p><b>{{ 'View details' | t }} ↗</b></div></a>{% endfor %}</div></div></section>
    {{ areas.main | raw }}
</main>
