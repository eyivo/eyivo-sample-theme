<main id="main-content" class="blog-page">
    <header class="blog-header"><div class="blog-shell blog-post"><nav class="blog-breadcrumbs" aria-label="{{ 'Breadcrumb' | t }}"><a href="{{ routes.home }}">{{ 'Home' | t }}</a><span>/</span><a href="{{ blog.url }}">{{ 'Blog' | t }}</a></nav><h1>{{ blog.post.title }}</h1><div class="blog-post-meta"><time datetime="{{ blog.post.published_at }}">{{ blog.post.published_date }}</time></div><div class="blog-post-categories">{% for category in blog.post.categories %}<a href="{{ category.url }}">{{ category.name }}</a>{% endfor %}</div>{% if blog.post.summary %}<p>{{ blog.post.summary }}</p>{% endif %}</div></header>
    <article class="blog-content"><div class="blog-shell blog-post">{% if blog.post.cover_media %}<img class="blog-post-cover" src="{{ blog.post.cover_media.url }}" alt="{{ blog.post.title }}" width="{{ blog.post.cover_media.width }}" height="{{ blog.post.cover_media.height }}">{% endif %}<div class="blog-post-body">{{ blog.post.body_html | raw }}</div><p class="mt-4"><a href="{{ blog.url }}">← {{ 'All posts' | t }}</a></p></div></article>
</main>
