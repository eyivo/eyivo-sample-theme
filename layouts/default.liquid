<!doctype html>
<html lang="{{ locale.code }}" dir="{{ locale.direction }}" data-theme-key="{{ theme.key }}" data-layout="workbench">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    {% eyivo_head %}
    <link rel="stylesheet" href="{{ 'css/base.css' | asset_url }}?v={{ assets.version }}">
    <link rel="stylesheet" href="{{ 'css/theme.css' | asset_url }}?v={{ assets.version }}">
</head>
<body id="page-top" class="theme-shell theme-sample-theme theme-{{ theme.key }} layout-workbench{% if theme.settings.show_color_mode %} sample-system-colors{% endif %}"{% if company.brand_style %} style="{{ company.brand_style }}"{% endif %}>
    <a class="skip-link" href="#main-content">{{ "Skip to content" | t }}</a>

    {% if theme.settings.announcement_text %}
        <aside class="announcement-bar" aria-label="{{ 'Announcement' | t }}">
            <div class="shell announcement-inner">
                <span class="announcement-code" aria-hidden="true">NEW</span>
                <span>{{ theme.settings.announcement_text }}</span>
                {% if theme.settings.announcement_link_url %}<a href="{{ theme.settings.announcement_link_url | localized_url }}">{{ theme.settings.announcement_link_label | default: "Learn more" | t }} <span aria-hidden="true">→</span></a>{% endif %}
            </div>
        </aside>
    {% endif %}

    <header class="site-header theme-header sample-header" data-site-header>
        <div class="shell sample-nav-row">
            <a class="brand-mark" href="{{ locale.home_url }}" aria-label="{{ company.name }} home">
                <span class="sample-brand-shape" aria-hidden="true"><i></i><i></i><i></i></span>
                <span class="brand-name">{{ company.name }}</span>
            </a>
            <nav class="desktop-nav" aria-label="{{ 'Primary navigation' | t }}">
                {% for item in navigation.main %}{% if forloop.index <= 5 %}<a href="{{ item.url }}"{% if item.active %} aria-current="page"{% endif %}>{% if item.kind == 'catalog' %}{{ theme.settings.catalog_label }}{% else %}{{ item.label }}{% endif %}</a>{% endif %}{% endfor %}
                {% if navigation.main.size > 5 %}<details class="more-menu"><summary>{{ 'More' | t }}<svg class="more-menu-icon" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="m3 4.5 3 3 3-3"/></svg></summary><div>{% for item in navigation.main %}{% if forloop.index > 5 %}<a href="{{ item.url }}"{% if item.active %} aria-current="page"{% endif %}>{% if item.kind == 'catalog' %}{{ theme.settings.catalog_label }}{% else %}{{ item.label }}{% endif %}</a>{% endif %}{% endfor %}</div></details>{% endif %}
            </nav>
            <div class="header-actions">
                <a class="button button-small header-cta" href="{{ theme.settings.header_cta_url | localized_url }}">{{ theme.settings.header_cta_label }}</a>
                <details class="sample-navigation">
                    <summary>{{ 'Quick navigation' | t }}</summary>
                    <nav aria-label="{{ 'Quick navigation' | t }}">
                        {% for item in navigation.main %}<a href="{{ item.url }}"{% if item.active %} aria-current="page"{% endif %}>{% if item.kind == 'catalog' %}{{ theme.settings.catalog_label }}{% else %}{{ item.label }}{% endif %}</a>{% endfor %}
                        {% if company.phone %}<a href="tel:{{ company.phone }}">{{ company.phone }}</a>{% endif %}
                        {% if company.email %}<a href="mailto:{{ company.email }}">{{ company.email }}</a>{% endif %}
                    </nav>
                </details>
            </div>
        </div>
        <div class="shell sample-context-row">
            <span><i aria-hidden="true"></i>{{ theme.settings.status_label }}</span>
            <span>{{ theme.settings.catalog_label }}</span>
            {% if locale.available.size > 1 %}<nav class="locale-switcher" aria-label="{{ 'Language' | t }}">{% for language in locale.available %}<a href="{{ language.url }}" lang="{{ language.code }}" hreflang="{{ language.code }}"{% if language.current %} aria-current="page"{% endif %}>{{ language.native_name }}</a>{% endfor %}</nav>{% endif %}
        </div>
    </header>

    {{ content | raw }}

    <footer class="site-footer theme-footer sample-footer">
        <div class="shell sample-footer-callout">
            <div><p>{{ theme.settings.catalog_label }}</p><h2>{{ theme.settings.footer_tagline }}</h2></div>
            <a class="button button-light" href="{{ theme.settings.header_cta_url | localized_url }}">{{ theme.settings.header_cta_label }} <span aria-hidden="true">↗</span></a>
        </div>
        <div class="shell footer-grid">
            <div class="footer-lead"><a class="brand-mark brand-mark-footer" href="{{ locale.home_url }}"><span class="sample-brand-shape" aria-hidden="true"><i></i><i></i><i></i></span><span class="brand-name">{{ company.name }}</span></a><p>{{ company.description }}</p></div>
            {% if navigation.footer.size > 0 %}<div><p class="footer-label">{{ 'Explore' | t }}</p>{% for item in navigation.footer %}<a href="{{ item.url }}">{{ item.label }}</a>{% endfor %}</div>{% endif %}
            <div><p class="footer-label">{{ 'Contact' | t }}</p>{% if company.phone %}<a href="tel:{{ company.phone }}">{{ company.phone }}</a>{% endif %}{% if company.email %}<a href="mailto:{{ company.email }}">{{ company.email }}</a>{% endif %}{% if company.address %}<span>{{ company.address }}</span>{% endif %}</div>
            <div><p class="footer-label">{{ 'Follow' | t }}</p>{% for link in company.social_links %}<a href="{{ link.url }}" rel="noopener noreferrer nofollow">{{ link.label }}</a>{% endfor %}</div>
        </div>
        <div class="shell footer-base"><span>© {{ company.legal_name | default: company.name }}</span><span>Eyivo Theme API 1.0</span></div>

        {% if navigation.useful_links.size > 0 %}<nav class="shell sample-useful-links" aria-label="{{ 'Useful links' | t }}"><strong>{{ 'Useful links' | t }}</strong>{% for item in navigation.useful_links %}<a href="{{ item.url }}"{% if item.active %} aria-current="page"{% endif %}>{{ item.label }}</a>{% endfor %}</nav>{% endif %}
    </footer>

    {% if company.phone or theme.settings.whatsapp_url %}<aside class="contact-dock" aria-label="{{ 'Quick contact' | t }}">{% if company.phone %}<a href="tel:{{ company.phone }}"><span>{{ 'Call' | t }}</span><strong>{{ company.phone }}</strong></a>{% endif %}{% if theme.settings.whatsapp_url %}<a href="{{ theme.settings.whatsapp_url | localized_url }}" rel="noopener"><span>WhatsApp</span><strong>{{ 'Message us' | t }}</strong></a>{% endif %}</aside>{% endif %}
    {% if theme.settings.show_back_to_top %}<a class="back-to-top is-visible" href="#page-top" aria-label="{{ 'Back to top' | t }}">↑</a>{% endif %}
</body>
</html>
